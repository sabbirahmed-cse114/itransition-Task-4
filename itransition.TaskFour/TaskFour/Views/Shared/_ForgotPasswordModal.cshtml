<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordLabel">Account Recovery</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="step1">
                    <label>Email</label>
                    <input type="email" class="form-control" id="forgotEmail" required />
                    <div class="text-danger mt-1" id="emailError"></div>
                    <button class="text-center btn btn-primary mt-2" onclick="verifyEmail()">Submit</button>
                </div>
                <div id="step2" style="display:none;">
                    <label>New Password</label>
                    <input type="password" class="form-control" id="newPassword" required />
                    <button class="text-center btn btn-success mt-2" onclick="saveNewPassword()">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>