<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-4" style="z-index: 1100;">
    <div id="actionToast"
         class="toast align-items-center bg-success text-white border-0 p-3 rounded-4"
         role="alert"
         data-bs-delay="3000"
         style="width: 250px; height: 100px;">

        <div class="d-flex h-100">
            <div class="toast-body my-auto" id="toastMessage">
                Action completed successfully.
            </div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>
        </div>
    </div>
</div>

<script>
    function showToast(message) {
        document.getElementById("toastMessage").textContent = message;
        const toastEl = document.getElementById("actionToast");
        const toast = new bootstrap.Toast(toastEl);
        toast.show();
    }
</script>